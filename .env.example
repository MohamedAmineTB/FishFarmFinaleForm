# Copy to .env and fill in what you need. Never commit .env.

# Signing key for login tokens: set a long random value in production
JWT_SECRET=change-me-to-a-long-random-string

# Farm assistant. Leave empty to use the demo mode (prepared templates on live data).
ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic        # anthropic | openai_compat | mock (empty = automatic)
# LLM_MODEL=claude-haiku-5-5
# Local / offline model through an OpenAI-compatible server such as Ollama:
# LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=llama3.1

# Embeddings for the knowledge base: hash (default, no download) or sentence_transformers
# EMBEDDING_BACKEND=hash

# Simulator (6 s per reading; spike probability per tick)
# SIM_SPIKE_PROB=0.0015

# Local development without Docker
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fishfarm
